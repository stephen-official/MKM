# Server and database
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_db

# Generate two different long random values. Never use these placeholders in production.
JWT_SECRET=replace_with_a_long_random_access_token_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_token_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Operational caps, not authorization controls.
ADMIN_REGISTRATION_LIMIT=5
USER_REGISTRATION_LIMIT=100

# Comma-separated origins; do not add trailing slashes.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5174

# Optional: product-image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: password-reset email. Use an app password.
EMAIL_USER=
EMAIL_PASS=

# Business timezone for report day boundaries and schedules (default Asia/Kolkata).
# BUSINESS_TZ=Asia/Kolkata

# Run scheduled executive-report emails in this process (default false; safe on several instances).
# REPORT_SCHEDULER_ENABLED=true

# Only for `npm --prefix backend run create-super-admin`. Never commit real values.
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_PASSWORD=
